  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo"
      ]
    }
},
"chat.tools.terminal.autoApprove": {
	"/^Get-ChildItem -Path drivers -Recurse -Filter device\\.js \\| Select-String -Pattern \"async processWebhookMessage\\\\\\(message\\\\\\)\" -Context 0,35 \\| ForEach-Object \\{ \"`n--- \\$\\(\\$_\\.Path\\) ---\"; \\$_\\.Line; \\$_\\.Context\\.PostContext \\}$/": {
		"approve": true,
		"matchCommandLine": true
	}
}
}